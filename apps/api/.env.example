API_PORT=4000
API_HOST=0.0.0.0
FRONTEND_ORIGIN=http://localhost:3000
MONGODB_URI=mongodb://127.0.0.1:27017/reunite_dev
MONGODB_DATABASE=reunite_dev

# Cloudinary credentials from the Cloudinary Console. Keep the API secret private.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional SMTP delivery for moderator invitations and privacy-safe family notification emails.
# Port 587 uses STARTTLS; set SMTP_SECURE=true for implicit TLS (commonly port 465).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
